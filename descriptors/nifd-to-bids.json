{
  "schema-version": "0.5+styx",
  "name": "clinica-nifd-to-bids",
  "description": "NIFD to BIDS converter.\n\nConvert the imaging and clinical data of NIFD (https://4rtni-ftldni.ini.usc.edu/), located in DATASET_DIRECTORY and\nCLINICAL_DATA_DIRECTORY respectively, to a BIDS dataset in the target BIDS_DIRECTORY.\n",
  "command-line": "clinica convert nifd-to-bids [DATASET_DIRECTORY] [CLINICAL_DATA_DIRECTORY] [BIDS_DIRECTORY]",
  "inputs": [
    {
      "id": "dataset_directory",
      "type": "File",
      "value-key": "[DATASET_DIRECTORY]",
      "name": "dataset_directory"
    },
    {
      "id": "clinical_data_directory",
      "type": "File",
      "value-key": "[CLINICAL_DATA_DIRECTORY]",
      "name": "clinical_data_directory"
    },
    {
      "id": "bids_directory",
      "type": "File",
      "value-key": "[BIDS_DIRECTORY]",
      "name": "bids_directory"
    }
  ]
}
