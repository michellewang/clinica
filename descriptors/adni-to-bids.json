{
  "schema-version": "0.5+styx",
  "name": "clinica-adni-to-bids",
  "description": "ADNI to BIDS converter.\n\nConvert the imaging and clinical data of ADNI (https://adni.loni.usc.edu/), located in DATASET_DIRECTORY and\nCLINICAL_DATA_DIRECTORY respectively, to a BIDS dataset in the target BIDS_DIRECTORY.\n",
  "command-line": "clinica convert adni-to-bids [DATASET_DIRECTORY] [CLINICAL_DATA_DIRECTORY] [BIDS_DIRECTORY] [SUBJECTS_LIST] [CLINICAL_DATA_ONLY] [FORCE_NEW_EXTRACTION] [MODALITIES] [XML_PATH] [N_PROCS]",
  "inputs": [
    {
      "id": "dataset_directory",
      "type": "File",
      "value-key": "[DATASET_DIRECTORY]",
      "name": "dataset_directory"
    },
    {
      "id": "clinical_data_directory",
      "type": "File",
      "value-key": "[CLINICAL_DATA_DIRECTORY]",
      "name": "clinical_data_directory"
    },
    {
      "id": "bids_directory",
      "type": "File",
      "value-key": "[BIDS_DIRECTORY]",
      "name": "bids_directory"
    },
    {
      "id": "subjects_list",
      "type": "File",
      "value-key": "[SUBJECTS_LIST]",
      "description": "Path to a text file containing a list of specific subjects to extract.The expected format is one subject ID per line.",
      "optional": true,
      "command-line-flag": "--subjects_list",
      "name": "subjects_list"
    },
    {
      "id": "clinical_data_only",
      "type": "Flag",
      "value-key": "[CLINICAL_DATA_ONLY]",
      "description": "Convert clinical data only.",
      "optional": true,
      "command-line-flag": "--clinical-data-only",
      "name": "clinical_data_only"
    },
    {
      "id": "force_new_extraction",
      "type": "Flag",
      "value-key": "[FORCE_NEW_EXTRACTION]",
      "description": "Force new data extraction.",
      "optional": true,
      "command-line-flag": "--force-new-extraction",
      "name": "force_new_extraction"
    },
    {
      "id": "modalities",
      "type": "String",
      "value-key": "[MODALITIES]",
      "description": "Convert only the selected modality. By default, all available modalities are converted.",
      "list": true,
      "min-list-entries": 0,
      "command-line-flag": "--modalities",
      "value-choices": [
        "T1",
        "PET_FDG",
        "PET_AMYLOID",
        "PET_TAU",
        "DWI",
        "FLAIR",
        "fMRI",
        "FMAP"
      ],
      "name": "modalities"
    },
    {
      "id": "xml_path",
      "type": "String",
      "value-key": "[XML_PATH]",
      "description": "Path to the root directory containing the xml metadata.",
      "optional": true,
      "command-line-flag": "--xml_path",
      "name": "xml_path"
    },
    {
      "id": "n_procs",
      "type": "Number",
      "value-key": "[N_PROCS]",
      "description": "Number of cores used to run in parallel.",
      "optional": true,
      "command-line-flag": "--n_procs",
      "integer": true,
      "name": "n_procs"
    }
  ]
}
